# Copy to .env.staging and fill in from the STAGING project: Project Settings → API.
# Used by `npm run dev:staging`. Never put the live project's values here.
VITE_SUPABASE_PROJECT_ID=your-staging-project-ref
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-staging-anon-public-key

# The lifecycle migration is part of bootstrap.sql, so this is on in staging
VITE_LISTING_LIFECYCLE=true
VITE_MOATWAVE_PREVIEWS=true
