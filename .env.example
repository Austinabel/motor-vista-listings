# Copy to .env (local) or set in the hosting provider's environment settings.
# Use the staging project's values for staging and the production project's values in production.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

